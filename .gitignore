# Зависимости для проверок (jsdom используется только tools/smoke-test.js)
node_modules/

# Сырые выгрузки с официального портала: каждый прогон обновления скачивает
# их заново, поэтому в git не хранятся. В репозитории лежит только результат
# сборки — data/.
vendor/

# Кеш скачанных страниц (sudact.ru — Пленумы и обзоры судебной практики).
# Нужен только чтобы повторный запуск не дёргал источник заново; в репозиторий
# не идёт — это десятки мегабайт чужой разметки.
.tmp-probe/

# Служебные файлы редакторов и ОС
.DS_Store
Thumbs.db
desktop.ini

# Vercel
.vercel/

# Каталог публикации: производная от data/, его собирает хостинг
# (или `npm run dist` перед ручной выгрузкой). В репозитории не хранится.
dist/

# Логи действий GitHub не нужны в репозитории
*.log

# Рабочие файлы ассистента: профили headless-браузера (тысячи мелких файлов),
# резервные копии данных, отладочные скрипты, проверочные снимки экрана и
# заметки о ходе работы. Репозиторий публичный — этого требует GitHub Pages на
# бесплатном плане, — поэтому из этого каталога в него не идёт ничего, целиком.
# Заметки вычищены и из истории коммитов (DEPLOY.md, §3.3).
.workbuddy-ai/
