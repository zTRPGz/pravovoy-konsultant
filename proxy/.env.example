# --- ключи GigaChat (взять в личном кабинете developers.sber.ru) -----------
# Authorization key из кабинета — это строка "client_id:client_secret" в base64.
# Здесь нужны именно id и секрет по отдельности: прокси сам соберёт Basic-заголовок.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Права доступа: для физлиц — GIGACHAT_API_PERS, для юрлиц — GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat (Lite), GigaChat-Pro, GigaChat-Max
GIGACHAT_MODEL=GigaChat

# --- кому можно обращаться к прокси ---------------------------------------
# Через запятую, точное совпадение с Origin. Для GitHub Pages:
#   ALLOWED_ORIGINS=https://ztrpgz.github.io
# "*" разрешает всем — так делать не надо: ключ будут жечь чужие скрипты.
ALLOWED_ORIGINS=

# --- лимиты (защита квоты) -------------------------------------------------
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_PER_DAY=400

# --- необязательный общий токен -------------------------------------------
# Если задан, клиент обязан присылать заголовок X-Proxy-Token с этим значением.
# Полезно, когда прокси открыт в интернете и нужно прикрыть его от перебора.
SHARED_TOKEN=

# --- порт для автономного сервера -----------------------------------------
PORT=8080
HOST=0.0.0.0

# --- сертификаты НУЦ Минцифры (обязательно для GigaChat) ------------------
# Скачать: https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
# Прокси сам читает russian_trusted_root_ca.pem рядом с собой, а если файла
# нет — берёт встроенную копию из lib/russian-root-ca.js. Поэтому переменная
# ниже нужна только для собственных скриптов, которые ходят в GigaChat мимо
# прокси. Подменять сертификат без надобности не требуется.
# NODE_EXTRA_CA_CERTS=/opt/proxy/russian_trusted_root_ca.pem
